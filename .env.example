# ─────────────────────────────────────────────────────────────
# Creator Academy — environment variables
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used in emails and payment callbacks)
SITE_URL=http://localhost:3000

# ── Public business details (shown on the site & policy pages) ──
# Use ACCURATE details of the payment-account holder / business (required by payment providers).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_JURISDICTION=India

# ── Database ────────────────────────────────────────────────
# Local development: a SQLite file (created automatically by `npm run db:setup`)
DATABASE_URL=file:data/academy.db
# Production (e.g. Vercel): create a free Turso database and use its URL + token
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=eyJ...
DATABASE_AUTH_TOKEN=

# ── Admin dashboard (/admin) ────────────────────────────────
# Password for the operations dashboard. Use something long.
ADMIN_PASSWORD=change-me-to-a-long-password
# Random secret used to sign admin session cookies (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# ── Payments (Razorpay) ─────────────────────────────────────
# Leave these empty to run in DEMO mode (payments are simulated, clearly labelled).
# Get keys from https://dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay Dashboard → Webhooks → add {SITE_URL}/api/webhooks/razorpay
# with the "payment.captured" and "order.paid" events)
RAZORPAY_WEBHOOK_SECRET=
# Production only: set to "true" to allow SIMULATED payments without Razorpay keys (public demos).
# Never enable this on the real launch.
ALLOW_DEMO_PAYMENTS=

# ── Email ──
# Leave everything below empty to only log emails in the admin dashboard
# (nothing is sent). Resend is tried first if set; SMTP is a fallback for
# hosts where Resend isn't an option (note: SMTP is not guaranteed to work on
# Cloudflare Workers — Resend is the one that reliably does).

# Resend (recommended) — https://resend.com → dashboard → API Keys.
RESEND_API_KEY=

# SMTP fallback (any provider: Zoho Mail, Google Workspace, Brevo, etc.) —
# only used when RESEND_API_KEY is not set.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# The "From" address, used by whichever provider is active. Leave empty to
# use Resend's shared sandbox sender (onboarding@resend.dev — works
# immediately, no setup) when using Resend. e.g. Creator Academy <hello@youracademy.in>
EMAIL_FROM=
