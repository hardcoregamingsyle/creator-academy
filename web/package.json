{
  "name": "createva-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p functions/tsconfig.json --noEmit && tsc -p live-worker/tsconfig.json --noEmit",
    "dev:api": "tsx scripts/node-api.ts",
    "dev:live": "wrangler dev -c live-worker/wrangler.toml --local --port 8790",
    "deploy:live": "wrangler deploy -c live-worker/wrangler.toml",
    "preview:pages": "wrangler pages dev dist --compatibility-flags=nodejs_compat",
    "typecheck:client": "tsc -p tsconfig.json --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p live-worker/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "hono": "^4.6.0",
    "lucide-react": "1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "wrangler": "^4.141.0"
  }
}
