# Environment variables read by the API (functions/). Copy to .env.local for
# `npm run dev:api` (Node harness). On Cloudflare Pages set the non-secret ones
# in wrangler.toml [vars] and the secrets with `wrangler pages secret put`.
# With the nodejs_compat flag they all appear on process.env.

# --- Database (libSQL / Turso) -------------------------------------------
# Local dev: a SQLite file, relative to web/. Production: libsql://<db>.turso.io
# (file: URLs do not work on Workers).
DATABASE_URL=file:../data/academy.db
# Turso auth token (production only).
DATABASE_AUTH_TOKEN=

# --- Admin ---------------------------------------------------------------
# The single shared admin password.
ADMIN_PASSWORD=admin12345
# Signs the admin session cookie. Falls back to ADMIN_PASSWORD if unset; use a
# long random string in production.
SESSION_SECRET=dev-only-secret

# --- Site ----------------------------------------------------------------
# Public origin, no trailing slash. Used in emails and the CSRF origin allowlist.
SITE_URL=http://localhost:5173
CONTACT_EMAIL=hello@example.com
LEGAL_NAME=
LEGAL_ADDRESS=
JURISDICTION=India

# --- Email (Resend) ------------------------------------------------------
# Unset = emails are only recorded in the email log (/admin/emails).
RESEND_API_KEY=
# Sender, e.g. "CREATEVA <hello@yourdomain.com>". Defaults to Resend's sandbox sender.
EMAIL_FROM=

# --- Live classes --------------------------------------------------------
# Socket base of the room Worker (`npm run dev:live` listens on 8790). Production: wss://createva-live.<account>.workers.dev/room
LIVE_WS_URL=ws://127.0.0.1:8790/room
# Signs the class tickets. Must be the SAME value in live-worker/.dev.vars (LIVE_SECRET=...) and on both deployments.
LIVE_SECRET=dev-live-secret
# Bearer token the Worker's cron uses for POST /api/internal/reminders (also CRON_SECRET in live-worker/.dev.vars).
CRON_SECRET=dev-cron-secret
# Cloudflare Realtime SFU (screen sharing). Unset = screen sharing is hidden.
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=

# --- Payments (Razorpay) -------------------------------------------------
# Both key vars set = live payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Verifies POST /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Without Razorpay keys, payments are simulated when NODE_ENV is not
# "production"; set to true to allow the simulation in production too.
ALLOW_DEMO_PAYMENTS=
